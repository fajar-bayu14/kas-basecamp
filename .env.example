# Database MySQL (Local Laragon / Docker)
# Local: mysql://root:@localhost:3306/catatan_kas
# Docker (dari host): mysql://kas_user:kas_password@localhost:3307/catatan_kas
# Docker (inter-container): mysql://kas_user:kas_password@db:3306/catatan_kas
DATABASE_URL="mysql://root:@localhost:3306/catatan_kas"

# Next.js App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin Authentication
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="your_secure_password"
SESSION_SECRET="your_random_session_secret"
